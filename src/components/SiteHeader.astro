---
import { Image } from "astro:assets";
import logo from "@/assets/brand/logo-marron.png";

const links = [
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/blog", label: "Blog" },
  { href: "/a-propos", label: "À propos" },
];
const current = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-seashell/90 backdrop-blur border-b border-brown/10">
  <div class="mx-auto max-w-6xl px-5 h-18 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-3" aria-label="Soleya, accueil">
      <Image
        src={logo}
        alt=""
        width={40}
        height={41}
        class="size-10"
        loading="eager"
      />
      <span class="font-logo text-lg tracking-logo">SOLEYA</span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-8 text-sm">
        {links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[
                "hover:text-brown-soft transition-colors",
                current.startsWith(l.href) && "underline underline-offset-8",
              ]}
            >
              {l.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href="/contact"
            class="rounded-full bg-brown text-seashell px-5 py-2.5 hover:bg-brown-soft transition-colors"
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer rounded-full border border-brown/30 px-4 py-2 text-sm">
        Menu
      </summary>
      <ul class="absolute right-0 mt-3 w-56 rounded-2xl bg-seashell shadow-lg border border-brown/10 p-3 flex flex-col">
        {[...links, { href: "/contact", label: "Contact" }].map((l) => (
          <li>
            <a href={l.href} class="block rounded-xl px-4 py-3 hover:bg-butter">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>
