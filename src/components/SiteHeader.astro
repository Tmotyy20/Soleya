---
import { Image } from "astro:assets";
import logo from "@/assets/brand/logo-bleu-jaune.png";
import logotype from "@/assets/brand/logotype-soleya.png";

const links = [
  { href: "/", label: "Accueil" },
  { href: "/#a-propos", label: "À propos" },
  { href: "/#projets", label: "Projets" },
];
---

<header class="sticky top-0 z-40 bg-brown">
  <div class="mx-auto max-w-[85rem] px-5 h-20 md:h-24 flex items-center justify-between gap-6">
    <a href="/" class="flex items-center gap-4" aria-label="Soleya, accueil">
      <Image
        src={logo}
        alt=""
        width={56}
        height={57}
        class="size-12 md:size-14"
        loading="eager"
      />
      <Image
        src={logotype}
        alt=""
        width={120}
        height={17}
        class="h-3.5 md:h-[1.1rem] w-auto"
        loading="eager"
      />
    </a>

    <nav aria-label="Navigation principale" class="hidden md:block">
      <ul class="flex items-center gap-7 text-lg uppercase text-cream">
        {links.map((l) => (
          <li>
            <a href={l.href} class="hover:text-butter transition-colors">
              {l.label}
            </a>
          </li>
        ))}
        <li class="ml-2">
          <a
            href="/#contact"
            class="btn bg-butter text-brown font-title font-bold text-lg border border-brown hover:bg-nebula"
          >
            Contact
          </a>
        </li>
      </ul>
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer rounded-full bg-butter text-brown px-5 py-2 text-sm uppercase">
        Menu
      </summary>
      <ul class="absolute right-0 mt-3 w-56 rounded-2xl bg-cream shadow-lg p-3 flex flex-col uppercase text-sm">
        {[...links, { href: "/#contact", label: "Contact" }].map((l) => (
          <li>
            <a href={l.href} class="block rounded-xl px-4 py-3 hover:bg-butter">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</header>
