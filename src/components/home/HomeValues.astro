---
import { Image } from "astro:assets";
import logo from "@/assets/brand/logo-marron.png";

interface Props {
  title: string;
  items: string[];
}
const { title, items } = Astro.props;
---

<section class="stripes" aria-labelledby="values-title">
  <div class="mx-auto max-w-[85rem] px-5 md:px-[5.6%] pt-20 pb-28">
    <h2 id="values-title" class="title text-4xl md:text-5xl text-center">
      {title}
    </h2>
    <ul class="mt-12 grid gap-4 grid-cols-2 lg:grid-cols-4">
      {items.map((v) => (
        <li class="rounded-[var(--radius-card)] border-2 border-brown bg-cream min-h-[13.3rem] flex flex-col items-center justify-center gap-6 px-4 py-6">
          <Image
            src={logo}
            alt=""
            width={100}
            height={103}
            class="size-20 md:size-24"
          />
          <p class="title text-base md:text-xl text-center">{v}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
