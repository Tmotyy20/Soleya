---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  lead?: string;
  text: string;
  bullets: string; // une ligne par point
  cta: string;
  /** Visuel de gauche ; sinon, utiliser le slot "visual" */
  image?: ImageMetadata;
  imageAlt?: string;
  /** "brown" : fond brun clair, texte crème · "nebula" : fond bleu, texte marron */
  theme?: "brown" | "nebula";
  /** Largeur max de la colonne du visuel (ordinateur) */
  visualWidth?: string;
  /** Plus d'espace vertical (maquette Création textile) */
  spacious?: boolean;
}
const {
  title,
  lead,
  text,
  bullets,
  cta,
  image,
  imageAlt = "",
  theme = "brown",
  visualWidth = "21.75rem",
  spacious = false,
} = Astro.props;
const items = bullets
  .split("\n")
  .map((b) => b.trim())
  .filter(Boolean);
---

<section
  class:list={[
    theme === "brown" ? "bg-brown-light text-cream" : "bg-nebula text-brown",
  ]}
  aria-labelledby="intro-title"
>
  <div
    style={`--visual-w: ${visualWidth}`}
    class:list={[
      "mx-auto max-w-[85rem] px-5 md:px-[7.8%] grid gap-12 md:grid-cols-[minmax(0,var(--visual-w))_minmax(0,37.9rem)] md:justify-between items-center",
      spacious ? "py-16 md:py-[8rem]" : "py-16 md:py-[4.9rem]",
    ]}
  >
    {image ? (
      <Image
        src={image}
        alt={imageAlt}
        widths={[350, 700]}
        sizes="(min-width: 768px) 348px, 80vw"
        class="w-[75%] max-w-[21.75rem] md:w-full mx-auto h-auto drop-shadow-2xl"
      />
    ) : (
      <slot name="visual" />
    )}
    <div>
      <h2 id="intro-title" class="title text-butter text-4xl md:text-5xl">
        {title}
      </h2>
      {lead && <p class="mt-4">{lead}</p>}
      <p
        class:list={[
          lead ? "mt-5" : "mt-4",
          " whitespace-pre-line md:text-justify hyphens-auto",
        ]}
        lang="fr"
      >
        {text}
      </p>
      <ul class="mt-5 space-y-5 list-disc pl-7 md:text-justify" lang="fr">
        {items.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
      <a
        href="#contact"
        class="btn mt-8 bg-brown text-cream sm:min-w-[19.9rem] hover:bg-brown/80"
      >
        {cta}
      </a>
    </div>
  </div>
</section>
