---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceHero from "@/components/services/ServiceHero.astro";
import ServiceIntro from "@/components/services/ServiceIntro.astro";
import PacksSection from "@/components/services/PacksSection.astro";
import ClientLogosSection from "@/components/services/ClientLogosSection.astro";
import ValuesSection from "@/components/ValuesSection.astro";
import ContactSection from "@/components/ContactSection.astro";
import hero from "@/assets/services/cm-hero.jpg";
import phone from "@/assets/home/projet-instagram.png";
import {
  getClientLogos,
  getPacks,
  getSections,
  getSiteSettings,
} from "@/lib/content";

export const prerender = true;

const SERVICE = "community-management";
const [t, settings, packs, logos] = await Promise.all([
  getSections(),
  getSiteSettings(),
  getPacks(SERVICE),
  getClientLogos("cm"),
]);
const s = (key: string) => t[key] ?? "";
---

<BaseLayout
  title="Community management · Soleya"
  description="Community management sur Instagram, Facebook, LinkedIn et TikTok : packs à partir de 450 € par mois pour développer, animer et engager votre communauté."
>
  <ServiceHero
    title={s("cm.hero.title")}
    image={hero}
    imageAlt="Community manager souriante devant un écran de statistiques"
  />
  <ServiceIntro
    title={s("cm.intro.title")}
    lead={s("cm.intro.lead")}
    text={s("cm.intro.text")}
    bullets={s("cm.intro.bullets")}
    cta={s("cm.intro.cta")}
    image={phone}
    imageAlt="Aperçu d'un compte Instagram géré par Soleya"
  />
  <PacksSection
    title={s("cm.packs.title")}
    cta={s("cm.packs.cta")}
    packs={packs}
  />
  <ClientLogosSection
    title={s("cm.clients.title")}
    note={s("cm.clients.note")}
    type="cm"
    logos={logos}
  />
  <ValuesSection
    title={s("home.values.title")}
    items={[1, 2, 3, 4].map((n) => s(`home.values.${n}`))}
  />
  <ContactSection
    title={s("home.contact.title")}
    subtitle={s("home.contact.subtitle")}
    settings={settings}
  />
</BaseLayout>
