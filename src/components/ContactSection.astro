---
import { Image } from "astro:assets";
import logo from "@/assets/brand/logo-marron.png";
import type { SiteSettings } from "@/lib/database.types";

interface Props {
  title: string;
  subtitle: string;
  settings: Partial<SiteSettings>;
}
const { title, subtitle, settings } = Astro.props;

const field =
  "w-full rounded-full border border-brown bg-cream px-5 h-[3.375rem] focus:outline-2 focus:outline-brown";
const label = "block uppercase mb-3";
---

<section id="contact" class="bg-nebula" aria-labelledby="contact-title">
  <div class="mx-auto max-w-[85rem] px-5 md:px-[5.6%] pb-24 md:pb-36">
    <div class="text-center">
      <h2
        id="contact-title"
        class="title text-3xl md:text-5xl whitespace-pre-line"
      >
        {title}
      </h2>
      <p class="mt-3 text-lg">{subtitle}</p>
    </div>

    <div class="mt-16 md:mt-24 grid gap-14 lg:grid-cols-[minmax(0,42.5rem)_1fr] items-start">
      <form
        method="post"
        action="/api/contact"
        class="rounded-[var(--radius-card)] bg-cream p-6 sm:px-[3.3rem] sm:py-10"
      >
        <input type="hidden" name="from" value={Astro.url.pathname} />
        <div
          id="contact-status"
          role="status"
          class="hidden mb-6 rounded-2xl px-5 py-4"
        ></div>

        <div class="grid gap-x-5 gap-y-8 sm:grid-cols-2">
          <div>
            <label for="last_name" class={label}>
              Nom :
            </label>
            <input
              id="last_name"
              name="last_name"
              required
              maxlength="120"
              autocomplete="family-name"
              class={field}
            />
          </div>
          <div>
            <label for="first_name" class={label}>
              Prénom :
            </label>
            <input
              id="first_name"
              name="first_name"
              required
              maxlength="120"
              autocomplete="given-name"
              class={field}
            />
          </div>
          <div class="sm:col-span-2">
            <label for="email" class={label}>
              Mail :
            </label>
            <input
              id="email"
              name="email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
              class={field}
            />
          </div>
          <div class="sm:col-span-2">
            <label for="phone" class={label}>
              Téléphone :
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              maxlength="30"
              autocomplete="tel"
              class={field}
            />
          </div>
          <div class="sm:col-span-2">
            <label for="message" class={label}>
              Message :
            </label>
            <textarea
              id="message"
              name="message"
              required
              maxlength="5000"
              rows="5"
              class="w-full rounded-[1.75rem] border border-brown bg-cream px-5 py-4 focus:outline-2 focus:outline-brown"
            ></textarea>
          </div>
        </div>

        <!-- Piège à robots : champ invisible pour les humains -->
        <div class="hidden" aria-hidden="true">
          <label>
            Ne pas remplir{" "}
            <input name="website" tabindex="-1" autocomplete="off" />
          </label>
        </div>

        <p class="mt-6 text-xs text-brown-light">
          Vos données servent uniquement à vous répondre. Voir la{" "}
          <a href="/confidentialite" class="underline">
            politique de confidentialité
          </a>
          .
        </p>

        <div class="mt-6 flex justify-end">
          <button class="btn bg-brown text-cream min-w-[9.9rem] hover:bg-brown-light">
            Envoyer
          </button>
        </div>
      </form>

      <div class="flex flex-col items-center gap-10 lg:pt-0">
        <Image
          src={logo}
          alt=""
          width={200}
          height={205}
          class="w-40 md:w-52 h-auto"
        />
        <ul class="flex flex-col gap-10 text-cream">
          {settings.instagram_url && (
            <li>
              <a
                href={settings.instagram_url}
                target="_blank"
                rel="noopener"
                class="flex items-center gap-6 hover:underline"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="size-12 shrink-0"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle
                    cx="17.5"
                    cy="6.5"
                    r="1"
                    fill="currentColor"
                    stroke="none"
                  />
                </svg>
                <span>
                  <span class="sr-only">Instagram : </span>
                  {settings.instagram_handle ?? "Instagram"}
                </span>
              </a>
            </li>
          )}
          {settings.contact_email && (
            <li>
              <a
                href={`mailto:${settings.contact_email}`}
                class="flex items-center gap-4 hover:underline break-all"
              >
                <svg
                  viewBox="0 0 32 20"
                  class="w-16 h-10 shrink-0"
                  aria-hidden="true"
                >
                  <rect width="32" height="20" rx="2" fill="currentColor" />
                  <path
                    d="M1 1l15 11L31 1M1 19l11-9M31 19l-11-9"
                    fill="none"
                    class="stroke-nebula"
                    stroke-width="1.5"
                  />
                </svg>
                <span>
                  <span class="sr-only">Email : </span>
                  {settings.contact_email}
                </span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  // Affiche le résultat de l'envoi (la page est statique, l'API redirige ici avec ?contact=…)
  const status = new URLSearchParams(location.search).get("contact");
  const box = document.getElementById("contact-status");
  const messages: Record<string, [string, string]> = {
    ok: [
      "Merci, votre message a bien été envoyé ! Je vous réponds très vite.",
      "bg-butter",
    ],
    invalid: ["Merci de vérifier les champs du formulaire.", "bg-seashell"],
    error: [
      "Une erreur est survenue. Vous pouvez m'écrire directement par mail.",
      "bg-seashell",
    ],
  };
  // Pré-remplit le message quand on arrive depuis un pack (?pack=Nom du pack#contact)
  const pack = new URLSearchParams(location.search).get("pack");
  const message = document.getElementById(
    "message",
  ) as HTMLTextAreaElement | null;
  if (pack && message && !message.value) {
    message.value = `Bonjour, je suis intéressé(e) par le ${pack.slice(0, 80)}.`;
  }

  if (box && status && messages[status]) {
    const [text, bg] = messages[status];
    box.textContent = text;
    box.classList.remove("hidden");
    box.classList.add(bg);
  }
</script>
