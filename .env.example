# Copier en .env (dev) — en production, définir ces variables dans Cloudflare Pages.
PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
# URL du deploy hook Cloudflare Pages (rebuild du site après une modif dans /admin)
CLOUDFLARE_DEPLOY_HOOK_URL=
# Uniquement pour le script de seed en local. Ne JAMAIS l'exposer côté client ni la committer.
SUPABASE_SERVICE_ROLE_KEY=
