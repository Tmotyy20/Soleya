---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt?: string;
}
const { title, image, imageAlt = "" } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-brown-light">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 1024, 1366, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 size-full object-cover"
  />
  <div class="mx-auto max-w-[85rem] px-5 min-h-[22rem] md:min-h-[41.8rem] grid place-items-center text-center">
    <h1 class="title text-butter text-4xl md:text-5xl drop-shadow-[0_2px_12px_rgba(70,46,35,0.35)]">
      {title}
    </h1>
  </div>
</section>
