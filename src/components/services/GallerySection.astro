---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { Project } from "@/lib/database.types";
import { mediaUrl } from "@/lib/supabase";
import { defaultGalleries } from "@/lib/defaults";

interface Props {
  title: string;
  subtitle?: string;
  category: "identite_visuelle" | "print";
  projects: Project[]; // publiés dans Supabase ; vide = repli sur les visuels du repo
  /**
   * "collage" : 4 colonnes de visuels de tailles libres (logos, chartes)
   * "grid" : grille régulière de 5 affiches
   */
  layout: "collage" | "grid";
}
const { title, subtitle, category, projects, layout } = Astro.props;

const local = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/gallery/*/*.{png,jpg}",
  { eager: true },
);
const folder = category === "print" ? "print" : "identite";
type Item = { title: string; remote?: string; local?: ImageMetadata };
const items: Item[] =
  projects.length > 0
    ? projects
        .filter((p) => p.cover_image)
        .map((p) => ({
          title: p.cover_alt || p.title,
          remote: mediaUrl(p.cover_image) ?? "",
        }))
    : defaultGalleries[category].flatMap((g) => {
        const img = local[`/src/assets/gallery/${folder}/${g.file}`]?.default;
        return img ? [{ title: g.title, local: img }] : [];
      });

// Collage : les visuels sont répartis en 4 colonnes, dans l'ordre (colonne par colonne)
const columns =
  layout === "collage"
    ? Array.from({ length: 4 }, (_, c) =>
        items.slice(
          c * Math.ceil(items.length / 4),
          (c + 1) * Math.ceil(items.length / 4),
        ),
      ).filter((col) => col.length > 0)
    : [];
---

<section class="bg-cream" aria-labelledby="gallery-title">
  <div
    class:list={[
      "mx-auto max-w-[85rem] px-5",
      layout === "collage"
        ? "md:px-[5.5%] pt-14 md:pt-[5.6rem] pb-8"
        : "md:px-[8.1%] pt-10 md:pt-12 pb-14",
    ]}
  >
    <h2 id="gallery-title" class="title text-4xl md:text-5xl text-center">
      {title}
    </h2>
    {subtitle && <p class="mt-1 text-center">{subtitle}</p>}

    {layout === "collage" ? (
      <div class="mt-8 grid grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 lg:gap-x-14 items-center">
        {columns.map((col) => (
          <ul class="flex flex-col items-center justify-center gap-8 lg:gap-12 h-full">
            {col.map((it) => (
              <li class="w-full flex justify-center">
                {it.local ? (
                  <Image
                    src={it.local}
                    alt={it.title}
                    widths={[260, 520]}
                    sizes="(min-width: 1024px) 252px, 45vw"
                    class="max-w-full max-h-[20rem] w-auto h-auto object-contain"
                  />
                ) : (
                  <img
                    src={it.remote}
                    alt={it.title}
                    loading="lazy"
                    decoding="async"
                    class="max-w-full max-h-[20rem] w-auto h-auto object-contain"
                  />
                )}
              </li>
            ))}
          </ul>
        ))}
      </div>
    ) : (
      <ul class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-x-6 lg:gap-x-[3.5rem] gap-y-4">
        {items.map((it) => (
          <li class="h-[13rem] sm:h-[15rem] flex items-center justify-center">
            {it.local ? (
              <Image
                src={it.local}
                alt={it.title}
                widths={[220, 440]}
                sizes="(min-width: 1024px) 207px, 45vw"
                class="max-w-full max-h-full w-auto h-auto object-contain"
              />
            ) : (
              <img
                src={it.remote}
                alt={it.title}
                loading="lazy"
                decoding="async"
                class="max-w-full max-h-full w-auto h-auto object-contain"
              />
            )}
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
