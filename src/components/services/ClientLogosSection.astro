---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { ClientLogo, LogoType } from "@/lib/database.types";
import { mediaUrl } from "@/lib/supabase";
import { defaultLogos } from "@/lib/defaults";

interface Props {
  title: string;
  note: string;
  type: LogoType;
  logos: ClientLogo[]; // depuis Supabase ; vide = repli sur les logos du repo
}
const { title, note, type, logos } = Astro.props;

// Repli sans Supabase : logos embarqués dans src/assets/clients/<type>
const local = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/clients/*/*.png",
  { eager: true },
);
type Item = { name: string; remote?: string; local?: ImageMetadata };
const items: Item[] =
  logos.length > 0
    ? logos.map((l) => ({ name: l.name, remote: mediaUrl(l.image_path) ?? "" }))
    : defaultLogos[type].flatMap((l) => {
        const img = local[`/src/assets/clients/${type}/${l.file}`]?.default;
        return img ? [{ name: l.name, local: img }] : [];
      });

// CM : gros logos, 4 colonnes, note dans la 4e colonne de la dernière ligne.
// UGC : petits logos de marques, 4 colonnes + note dans une 5e colonne à droite.
const ugc = type === "ugc";
const lastRow = Math.max(1, Math.ceil(items.length / 4));
const logoClass = ugc
  ? "max-h-[3.75rem] max-w-[9.4rem] w-auto h-auto object-contain"
  : "max-h-[7.25rem] max-w-[10.5rem] w-auto h-auto object-contain";
---

<section class="bg-cream" aria-labelledby="clients-title">
  <div
    class:list={[
      "mx-auto max-w-[85rem] px-5",
      ugc
        ? "md:px-[4.3%] pt-12 md:pt-14 pb-14"
        : "md:px-[5.1%] pt-14 md:pt-24 pb-20 md:pb-28",
    ]}
  >
    <h2 id="clients-title" class="title text-3xl md:text-5xl text-center">
      {title}
    </h2>

    <ul
      style={`--last-row: ${lastRow}`}
      class:list={[
        "grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 items-center",
        ugc
          ? "mt-10 gap-x-8 gap-y-8 lg:gap-y-[1.6rem] lg:grid-cols-[repeat(4,minmax(0,1fr))_13rem]"
          : "mt-12 gap-x-8 gap-y-12 lg:gap-y-[3.2rem] lg:max-w-[59rem]",
      ]}
    >
      {items.map((l, i) => (
        <li
          style={ugc ? `--col: ${(i % 4) + 1}` : undefined}
          class:list={[
            "flex justify-center items-center",
            ugc ? "h-[4.5rem] lg:[grid-column:var(--col)]" : "h-[7.25rem]",
          ]}
        >
          {l.local ? (
            <Image
              src={l.local}
              alt={l.name}
              width={ugc ? 300 : 240}
              class={logoClass}
            />
          ) : (
            <img
              src={l.remote}
              alt={l.name}
              loading="lazy"
              decoding="async"
              class={logoClass}
            />
          )}
        </li>
      ))}
      <li
        class:list={[
          "col-span-2 sm:col-span-1 flex justify-center lg:justify-end",
          ugc
            ? "lg:col-start-5 lg:[grid-row:var(--last-row)] lg:-mt-16"
            : "lg:col-start-4",
        ]}
        aria-hidden="true"
      >
        <div class="relative pt-14 -rotate-[9deg]">
          <svg
            viewBox="0 0 110 60"
            class="absolute -left-4 top-0 w-24 text-brown"
            fill="none"
          >
            <path
              d="M100 56C88 30 62 14 12 18"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"
            ></path>
            <path
              d="M24 6L10 18l15 10"
              stroke="currentColor"
              stroke-width="5"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <p class="title text-lg leading-tight whitespace-pre-line">{note}</p>
        </div>
      </li>
    </ul>
  </div>
</section>
